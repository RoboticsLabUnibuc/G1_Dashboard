      "properties": {
        "state": {
          "enum": [
            "LOCOMOTION_READY",
            "WAITING_FOR_STOP",
            "XR_ALIGNMENT",
            "ARM_RAMP_UP",
            "XR_ACTIVE",
            "XR_TRACKING_HOLD",
            "SAFETY_FAULT_HOLD",
            "RETURN_ARMS_HOME",
            "ARM_RAMP_DOWN"
          ]
        },
        "arm_ownership_weight": {
          "$ref": "#/$defs/nullableNumber"
        },
        "shutdown_pending": {
          "type": "boolean"
        },
        "safety_fault_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "tracking_hold_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "actions": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "g1_dashboard.action_readiness.v1"
        },
        "request_channel_enabled": {
          "type": "boolean"
        },
        "xr_handover": {
          "type": "object",
          "properties": {
            "available": {
              "type": "boolean"
            },
            "operation": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "would_enter_state": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "engagement_conditions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
