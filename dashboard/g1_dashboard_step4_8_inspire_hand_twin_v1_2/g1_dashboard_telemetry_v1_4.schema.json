{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.example/g1-dashboard/telemetry/v1.4/schema.json",
  "title": "G1 XR Dashboard Telemetry v1.4 (full-body twin)",
  "description": "Read-only telemetry emitted by the V6.7.4 dashboard V1.4 full-body twin controller. Extends g1_dashboard.telemetry.v1 with 29-DoF measured LowState robot telemetry.",
  "type": "object",
  "required": [
    "schema",
    "sequence",
    "unix_time_s",
    "monotonic_s",
    "controller",
    "mode",
    "health",
    "motion",
    "tracking",
    "robot",
    "arms",
    "hands",
    "camera"
