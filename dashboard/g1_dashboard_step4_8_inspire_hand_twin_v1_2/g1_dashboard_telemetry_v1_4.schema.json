      "const": "g1_dashboard.telemetry.v1"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "unix_time_s": {
      "$ref": "#/$defs/nullableNumber"
    },
    "monotonic_s": {
      "$ref": "#/$defs/nullableNumber"
    },
    "controller": {
      "type": "object",
      "required": [
        "version",
        "pid",
        "main_loop_hz",
        "teleop_weight_limit",
        "allow_locomotion_during_xr",
        "symmetric_thumb_rotation"
      ],
      "properties": {
        "version": {
          "const": "V6.7.4_SYMMETRIC_THUMB_CONTROL_DASHBOARD_V1.4_FULL_BODY_TWIN"
